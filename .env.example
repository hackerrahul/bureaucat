# Copy to .env for local prod compose, or paste into Coolify → Environment Variables.
# Coolify auto-detects every ${VAR} referenced in docker-compose.prod.yml.

APP_ENV=production
APP_PORT=1341
VERSION=latest

# Postgres
POSTGRES_USER=bureaucat
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=bureaucat
DATABASE_URL=postgres://bureaucat:change-me-strong-password@postgres:5432/bureaucat?sslmode=disable

# App auth (openssl rand -hex 32)
JWT_SECRET=replace-with-openssl-rand-hex-32
# ACCESS_TOKEN_EXPIRY_MINS=5
# REFRESH_TOKEN_EXPIRY_DAYS=7

# Optional seed user
# DEMO_USER_EMAIL=admin@example.com
# DEMO_USER_PASSWORD=change-me

# Uploads / S3 (Garage in this compose)
S3_ENDPOINT=http://garage:3900
FILES_BUCKET_NAME=bureaucat
# Access key must look like Garage keys: GK + 32 hex chars
#   echo "GK$(openssl rand -hex 16)"
FILES_BUCKET_ACCESS_KEY_ID=GKreplace-with-openssl-rand-hex-16
#   openssl rand -hex 32
FILES_BUCKET_SECRET_ACCESS_KEY=replace-with-openssl-rand-hex-32
# MAX_UPLOAD_SIZE=10485760

# Garage cluster secrets (persist these — changing them orphans existing data)
#   openssl rand -hex 32
GARAGE_RPC_SECRET=replace-with-openssl-rand-hex-32
#   openssl rand -base64 32
GARAGE_ADMIN_TOKEN=replace-with-openssl-rand-base64-32
